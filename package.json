{
  "name": "@vibeuncle/gpgb-ui",
  "version": "0.1.0",
  "private": true,
  "description": "\u5927\u9053\u5927\u5546 shared design system: tokens, CSS component layer, React components",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css",
    "./fonts.css": "./styles/fonts.css",
    "./styles.css": "./styles/index.css",
    "./logo/*": "./assets/logo/*"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": "^4",
    "lucide-react": ">=0.400"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5",
    "@tailwindcss/cli": "^4",
    "@types/react-dom": "^19",
    "esbuild": "^0.25",
    "lucide-react": "^0.562.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "styleguide:build": "tailwindcss -i styleguide/input.css -o styleguide/styleguide.css --minify",
    "test": "node test/run.mjs",
    "check": "npm run typecheck && npm test",
    "pack:to": "npm pack --pack-destination"
  },
  "files": [
    "src",
    "styles",
    "assets",
    "DESIGN.md",
    "DESIGN_SYSTEM.md",
    "README.md"
